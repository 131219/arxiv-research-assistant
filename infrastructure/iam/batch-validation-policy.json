{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadArchiveCompletionMarkers",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::arxiv-bedrock-kb-123456789012/status/*"
      ]
    },
    {
      "Sid": "ListArchiveOutputs",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::arxiv-bedrock-kb-123456789012"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "processed/*"
          ]
        }
      }
    }
  ]
}
