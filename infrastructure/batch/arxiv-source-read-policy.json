{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectArxivBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::arxiv",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "pdf/*"
          ]
        }
      }
    },
    {
      "Sid": "DownloadArxivPdfArchives",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::arxiv/pdf/*"
    }
  ]
}
